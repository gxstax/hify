<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.hify</groupId>
    <artifactId>hify</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>hify-provider</artifactId>
  <name>hify-provider</name>
  <description>Model provider management: multi-provider configs (OpenAI/Claude/Gemini/Ollama), LLM calls with per-provider circuit breaker</description>

  <dependencies>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- REST controllers -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Cache provider/model configs, TTL 30min -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- provider / model_config tables -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <!-- Circuit breaker / retry / time limiter per provider -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
    </dependency>
  </dependencies>
</project>
