<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.hify</groupId>
    <artifactId>hify</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>hify-app</artifactId>
  <name>hify-app</name>
  <description>Spring Boot startup module: entry point aggregating every business module</description>

  <dependencies>
    <!-- Startup module depends on every business module -->
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-provider</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-workflow</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-knowledge</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-chat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Servlet container / REST handling -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Lombok for code in this module (provided scope is not transitive) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- MySQL driver (versions managed by spring-boot-dependencies BOM) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- PostgreSQL driver for pgvector -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Repackage into an executable fat jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
