<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Inherit from spring-boot-starter-parent: managed dependency versions and plugin versions -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
  </parent>

  <groupId>com.hify</groupId>
  <artifactId>hify</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>hify</name>
  <description>Hify - a lightweight AI Agent development platform (modular monolith, Dify-like)</description>

  <!--
    Modules are listed in dependency order:
    hify-chat -> hify-agent / hify-provider / hify-workflow / hify-knowledge
    hify-agent -> hify-mcp
    every business module -> hify-common
    hify-app (startup) -> every business module
  -->
  <modules>
    <module>hify-common</module>
    <module>hify-provider</module>
    <module>hify-mcp</module>
    <module>hify-agent</module>
    <module>hify-workflow</module>
    <module>hify-knowledge</module>
    <module>hify-chat</module>
    <module>hify-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- Versions NOT managed by the spring-boot-dependencies BOM are centralized here.
         Submodules must declare these without a <version>. -->
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <pgvector.version>0.1.6</pgvector.version>
    <okhttp.version>5.5.0</okhttp.version>
    <logstash-logback.version>9.0</logstash-logback.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <!-- JSqlParser-based interceptors (e.g. PaginationInnerInterceptor) were split
           out of the starter into this artifact since MyBatis-Plus 3.5.9 -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot3</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pgvector</groupId>
        <artifactId>pgvector</artifactId>
        <version>${pgvector.version}</version>
      </dependency>
      <!-- HTTP client for LLM streaming calls.
           OkHttp 5.x publishes a KMP metadata-only `okhttp` jar; plain Maven
           consumers must depend on the JVM artifact `okhttp-jvm`. -->
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp-jvm</artifactId>
        <version>${okhttp.version}</version>
      </dependency>
      <!-- JSON log encoder for the production logback appender -->
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>${logstash-logback.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!--
              maven-compiler-plugin 3.13+ and JDK 23+ no longer discover annotation
              processors from the classpath. Declare Lombok explicitly so that
              @Data / @Getter / @Slf4j ... actually generate code.
            -->
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
